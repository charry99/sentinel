# Sentinel — copy to .env and fill in. Devnet only. Never put a mainnet
# secret key in this file.
#
# RPC_URL=https://api.devnet.solana.com
# SENTINEL_KEYPAIR_PATH=/home/<you>/.config/sentinel/devnet-wallet.json
# SENTINEL_MARKET_NAME=BTC above $100k at 2026-11-20 12:00 UTC? (CoinGecko)
# SENTINEL_DEPOSIT_USDC=50
# SENTINEL_BUY_USDC=5
